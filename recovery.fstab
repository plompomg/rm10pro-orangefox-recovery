# Android fstab file.
# Device: Nubia RedMagic 10 Pro (NX789J)
# Platform: Snapdragon 8 Elite (sun) / Android 15
# Encryption: ICE wrappedkey / FBE policy 2

#<src>                                                   <mnt_point>   <type>   <mnt_flags and options>                                                                                                                    <fs_mgr_flags>

# Logical Partitions (Super)
system                                                   /system       ext4     ro,barrier=1,discard                                                                                                                       wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system_ext                                               /system_ext   ext4     ro,barrier=1,discard                                                                                                                       wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
product                                                  /product      ext4     ro,barrier=1,discard                                                                                                                       wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
vendor                                                   /vendor       ext4     ro,barrier=1,discard                                                                                                                       wait,slotselect,avb,logical,first_stage_mount
odm                                                      /odm          ext4     ro,barrier=1,discard                                                                                                                       wait,slotselect,avb,logical,first_stage_mount                                                                                                                    wait,slotselect,avb,logical,first_stage_mount
odm_dlkm                                                 /odm_dlkm     ext4     ro,barrier=1,discard                                                                                                                       wait,slotselect,avb,logical,first_stage_mount

# Physical Boot Partitions
/dev/block/bootdevice/by-name/misc                       /misc         emmc     defaults                                                                                                                                   defaults
/dev/block/bootdevice/by-name/frp                        /persistent   emmc     defaults                                                                                                                                   defaults

# Metadata (must mount before /data for wrappedkey derivation)
/dev/block/bootdevice/by-name/metadata                   /metadata     f2fs     noatime,nosuid,nodev,discard                                                                                                               wait,check,formattable,wrappedkey,first_stage_mount

# Userdata (ICE hardware encryption with wrappedkey)
/dev/block/bootdevice/by-name/userdata                   /data         f2fs     noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier                                                           latemount,wait,check,formattable,fileencryption=ice,wrappedkey,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M,sysfs_path=/sys/devices/platform/soc/1d84000.ufshc,checkpoint=fs

# Firmware and Persist
/dev/block/bootdevice/by-name/persist                    /persist      ext4     noatime,nosuid,nodev,barrier=1                                                                                                             wait
/dev/block/bootdevice/by-name/modem                      /firmware     vfat     ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0                                               wait

# USB OTG (no microSD slot on NX789J)
/devices/platform/soc/a600000.ssusb/*.dwc3/xhci-hcd.*.auto*   /usbotg   auto   nosuid,nodev                                                                                                                               wait,voldmanaged=usbotg:auto
